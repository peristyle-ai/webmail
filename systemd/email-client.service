[Unit]
Description=Email Client (Flask Web UI)
After=network.target mail-server.service
Wants=mail-server.service

[Service]
Type=simple
WorkingDirectory=/opt/py_pg_accounts/git/py_pg_client
Environment=FLASK_APP=run.py
Environment=FLASK_ENV=production
Environment=PYTHONPATH=/opt/py_pg_accounts/git/py_pg_client

ExecStart=/opt/py_pg_accounts/git/py_pg_client/.venv/bin/python /opt/py_pg_accounts/git/py_pg_client/run.py

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=email-client

[Install]
WantedBy=default.target
